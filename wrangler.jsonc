{
  // OPENAI_API_KEY is a Worker secret (not in this file). Set the same value for preview / staging / prod
  // in the dashboard (Variables → Encrypt) or via: wrangler secret put OPENAI_API_KEY -e <env>
  // Local dev: copy .dev.vars.example → .dev.vars and put your key there.
  "name": "ladder-llm",
  "main": "src/index.ts",
  "compatibility_date": "2026-03-26",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "observability": {
    "enabled": true
  },
  "vars": {
    "CLOUDFLARE_ACCESS_TEAM_DOMAIN": "https://ladderz.cloudflareaccess.com",
    "CLOUDFLARE_ACCESS_AUD": "db7688ec72e96fede34905cbc2b2ce759ff5910e5e9e4d5e6afa15ba9a7983a5"
  },
