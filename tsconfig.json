{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"strict": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"lib": ["ES2022", "WebWorker", "DOM.Iterable"],
		"types": ["./worker-configuration.d.ts"],
		"noEmit": true,
		"resolveJsonModule": true
	},
	"include": ["src/**/*", "worker-configuration.d.ts"],
	"exclude": ["node_modules", "tests"]
}
